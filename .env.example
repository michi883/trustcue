# TrustCue runs on Amazon Bedrock. Credentials come from the AWS SDK's default
# chain — an AWS profile, SSO, environment variables, or an instance role — so
# there is usually nothing to put here. Check yours with:
#   aws sts get-caller-identity

# Optional
# AWS_REGION=us-east-1
# TRUSTCUE_MODEL=us.amazon.nova-2-lite-v1:0
# TRUSTCUE_TEMPERATURE=0.3
# TRUSTCUE_DEBUG=1     # print retries and dropped signals to stderr
# TRUSTCUE_MOCK=1      # keyword stub, runs with no AWS access at all
# PORT=4173

# Voice. Amazon Polly speaks the replies; without AWS the browser's own
# speechSynthesis takes over on its own, so none of this is required.
# TRUSTCUE_VOICE=Ruth             # long-form is en-US only: Ruth, Danielle, Gregory, Patrick
# TRUSTCUE_TTS_ENGINE=long-form   # `generative` is 3x cheaper and adds en-GB (Amy, Brian)
# TRUSTCUE_TTS=off                # skip Polly entirely, use the browser voice
